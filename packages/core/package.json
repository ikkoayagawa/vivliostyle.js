{
  "name": "@ogenkou/vivliostyle-core-adaptive",
  "description": "Vivliostyle Core library for HTML+CSS typesetting with adaptive in-memory preview support (Ogenkou fork)",
  "version": "2.45.2-ogenkou.1",
  "author": "Vivliostyle Foundation",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./lib/vivliostyle.js",
  "module": "./lib/vivliostyle.mjs",
  "types": "./lib/vivliostyle.d.ts",
  "exports": {
    ".": {
      "import": "./lib/vivliostyle.mjs",
      "require": "./lib/vivliostyle.js",
      "types": "./lib/vivliostyle.d.ts"
    },
    "./resources/*": "./resources/*"
  },
  "files": [
    "lib",
    "resources"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:iife && npm run build:types",
    "build:esm": "esbuild src/vivliostyle.ts --bundle --outfile=lib/vivliostyle.mjs --format=esm --define:VIVLIOSTYLE_DEBUG=false --minify --sourcemap --target=es2022 --platform=node --external:fast-diff",
    "build:cjs": "esbuild src/vivliostyle.ts --bundle --outfile=lib/vivliostyle.js --format=cjs --define:VIVLIOSTYLE_DEBUG=false --minify --sourcemap --target=es2022 --platform=node --external:fast-diff",
    "build:iife": "esbuild src/vivliostyle.ts --bundle --outfile=lib/vivliostyle.iife.js --format=iife --global-name=VivliostyleCore --define:VIVLIOSTYLE_DEBUG=false --minify --sourcemap --target=es2022 --platform=browser",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap --outDir lib",
    "clean": "rimraf lib",
    "dev": "npm run build:esm -- --watch=forever"
  },
  "dependencies": {
    "fast-diff": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ikkoayagawa/vivliostyle.js.git",
    "directory": "packages/core"
  },
  "keywords": [
    "vivliostyle",
    "typesetting",
    "css",
    "html",
    "epub",
    "adaptive"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
